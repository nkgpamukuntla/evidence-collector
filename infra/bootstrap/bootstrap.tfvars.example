# Copy to <env>.tfvars (never commit).
region                         = "us-east-1"
environment                    = "dev"
key_admin_principal_arns       = ["arn:aws:iam::111111111111:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AWSAdministratorAccess_xxxx"]
state_user_principal_arns      = ["arn:aws:iam::111111111111:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AWSAdministratorAccess_xxxx"]
key_admin_assumer_arn_patterns = ["arn:aws:iam::111111111111:role/aws-reserved/sso.amazonaws.com/AWSReservedSSO_AWSAdministratorAccess_*"]
trail_retention_days           = 365
state_noncurrent_days          = 90
alert_email                    = ""
