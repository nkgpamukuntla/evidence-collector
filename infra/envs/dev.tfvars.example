# Copy to dev.tfvars locally (gitignored, never commit).
region                   = "us-east-1"
environment              = "dev"
availability_zones       = ["us-east-1a", "us-east-1b"]
vpc_cidr                 = "10.40.0.0/16"
tenant_ids               = []
raw_retention_days       = 90
key_deletion_window_days = 30
key_admin_principal_arns = [
  "<SSO admin role ARN (the principal running apply)>",
  "arn:aws:iam::<account>:role/ec-dev-key-admin", # from infra/bootstrap
]
terminator_principal_arns    = ["<SSO admin role ARN>"]
secret_writer_principal_arns = []
liveness_period_minutes      = 5
liveness_grace_periods       = 2
liveness_alarm_enabled       = false # R10: true only once the heartbeat publisher runs
log_retention_days           = 14

# --- hosting (cost: dev runs one NAT and one-AZ endpoints) ---
nat_gateway_count       = 1
endpoint_az_count       = 1
interface_endpoints     = ["ecr.api", "ecr.dkr", "logs", "kms"]
worker_desired_count    = 0 # stays 0 until the process entry point exists (R10)
evaluator_desired_count = 0
db_instance_class       = "db.t4g.micro"
db_multi_az             = false
db_allocated_storage    = 20
db_engine_version       = "16.15" # matches the pinned local/CI image (R9)
heartbeat_domain        = ""      # set once the external monitor is chosen

# --- portal ---
portal_desired_count     = 1
portal_admin_emails      = ["<you@company.com>"] # Cognito emails a temporary password
portal_allowed_countries = []                    # prod: ["US"]
db_bootstrap_command     = ["python", "-m", "app.migrate", "--dir", "migrations"]
